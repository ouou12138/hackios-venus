 /* SwapEnd: the swap is handed to the thread that puts frames on the panel, as soon as that has no other waiting. */
+bool
+IOMobileFramebuffer::stopForReturn(void)
+{
+	AbsoluteTime deadline;
+	clock_interval_to_deadline(2000, kMillisecondScale, &deadline);
+	IOLockLock(fSwapLock);
+	fReturnStopping = true;
+	IOLockWakeup(fSwapLock, &fSwapsWaiting, false);
+	while ((fSwapsWaiting || fPresenterReading) && mach_absolute_time() < deadline)
+		IOLockSleepDeadline(fSwapLock, &fReturnStopping, deadline, THREAD_UNINT);
+	bool drained = !fSwapsWaiting && !fPresenterReading;
+	redwood_tl("MiniIOMobileFramebuffer: return drain completed=%u queued=%u reading=%u\n",
+	    drained, fSwapsWaiting, fPresenterReading);
+	IOLockUnlock(fSwapLock);
+	return drained;
+}
